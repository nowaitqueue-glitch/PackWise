# PackWise — minimal env reference
# Prefer the full template: copy .env.local.example .env.local
#
# Do not put real secrets here. Never commit .env.local.

# --- Cron / packing reminders (server-only) ---
# Protects GET /api/cron/packing-reminders (Vercel cron 0 9 * * * / 09:00 UTC).
# Vercel sends: Authorization: Bearer <CRON_SECRET> — do not put the secret in the cron path.
CRON_SECRET=
# Local dry-run (use 3001 if 3000 is Postgres): Authorization Bearer + ?dryRun=1
# See .env.local.example for curl + required migrations (packing_reminder_email, reminder_log).

# --- Resend email (server-only) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Optional verified sender (defaults to Resend onboarding address).
# RESEND_FROM_EMAIL=PackWise <reminders@yourdomain.com>

# --- Supabase (required for cron trip queries) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public origin for packing-list links in emails (and Stripe).
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Amazon Shop Essentials (optional) ---
# Public URL for the curated Amazon list on packing pages.
# Leave unset to hide the Shop Essentials card (recommended until the list is live).
# NEXT_PUBLIC_AMAZON_LIST_URL=https://www.amazon.com/shop/your-storefront/list/...
