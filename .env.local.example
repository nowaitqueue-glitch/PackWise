# PackWise environment variables
# Copy to .env.local and fill in real values:
#   copy .env.local.example .env.local
#
# Do not leave YOUR_* / your-* placeholders in .env.local — app code and
# scripts (test-flow, test-api, create-test-user) reject them and exit early.
#
# On Vercel: Project → Settings → Environment Variables
# Add each for Production AND Preview (then redeploy).

# --- Supabase (required) ---
# Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Weather & city search ---
# Open-Meteo (forecast + geocoding) — no API key required.
# City combobox and trip weather both use Open-Meteo.
# Optional: show geocoded lat/lon under each day in the weather strip (dev only).
# NEXT_PUBLIC_DEBUG_WEATHER=true

# --- Analytics (optional, consent-gated) ---
# Plausible domain only — script loads after the user Accepts cookies.
# Example: packwise.app (no https://). Leave unset to skip analytics.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=packwise.app

# --- Google Gemini (server-only — do NOT use NEXT_PUBLIC_) ---
# Used for Scan My Suitcase vision (gemini-2.5-flash). Packing lists use
# curated weather-aware templates only (no Gemini).
# https://aistudio.google.com/apikey
# Leave empty here; set the real key only in .env.local (never commit it).
GEMINI_API_KEY=

# --- Pro / paid features (server-only) ---
# Force Pro for local testing (unlimited suitcase scans, skips Stripe).
# Production Pro is set via profiles.is_pro (Stripe webhook) or this override.
PACKWISE_PRO=false

# --- Stripe Checkout (server-only unless noted) ---
# Dashboard → Developers → API keys / Products
# https://dashboard.stripe.com/apikeys
# Create a recurring Price for PackWise Pro and paste its price_… id.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional yearly Pro recurring price (falls back to STRIPE_PRICE_ID if unset)
# STRIPE_PRICE_ID_YEARLY=
# Optional one-time price for +10 suitcase scans (mode=payment)
# STRIPE_PRICE_ID_SCAN_PACK=
# Optional: publishable key if you add Stripe.js client UI later
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret for POST /api/stripe/webhook
# (service role sets profiles.is_pro / scan credits; clients cannot)
# Events: checkout.session.completed, invoice.paid,
#         customer.subscription.updated|deleted
STRIPE_WEBHOOK_SECRET=
# Public app origin for Checkout success/cancel URLs (defaults to localhost:3000)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron / scheduled jobs (server-only) ---
# Protects GET /api/cron/packing-reminders (Vercel cron, 09:00 UTC daily).
# Send: Authorization: Bearer <CRON_SECRET>
# Generate a long random string, e.g. openssl rand -hex 32
CRON_SECRET=
#
# Local test (dev server; never commit the secret).
# If port 3000 is taken by Postgres (or another process), use 3001:
#   npx next dev -p 3001
#   curl -s -H "Authorization: Bearer $CRON_SECRET" \
#     "http://localhost:3001/api/cron/packing-reminders?dryRun=1"
# dryRun=1 skips Resend + reminder_log claims. Omit dryRun to send for real.
# Requires DB migrations if columns/tables are missing:
#   20260722180000_add_notification_prefs.sql (profiles.packing_reminder_email),
#   20260723000000_fix_profile_update_policy.sql,
#   20260726120000_create_reminder_log.sql
# Vercel cron path is /api/cron/packing-reminders only (no secret in URL).

# --- Resend email (server-only) ---
# Used by /api/cron/packing-reminders to email incomplete packing lists.
# https://resend.com/api-keys
# Leave empty here; set the real key only in .env.local (never commit it).
RESEND_API_KEY=
# Optional verified sender. Defaults to Resend onboarding address for local tests.
# RESEND_FROM_EMAIL=PackWise <reminders@yourdomain.com>
# Public app origin for packing-list links in emails (also used by Stripe).
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL is accepted as an alias by some hosts; prefer APP_URL.

# --- Test auth bootstrap (local only) ---
# Create / refresh the shared test user + JWT (writes the keys below):
#   node scripts/create-test-user.mjs --write-env
#   # or: npm run test:user
# Defaults: test@packwise.com / Test1234!
# Then run smoke / API / Playwright tests — all prefer TEST_USER_JWT.
#
# NEVER commit these values. JWTs expire; re-run create-test-user as needed.
TEST_USER_JWT=
TEST_USER_REFRESH_TOKEN=
TEST_USER_ID=
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_ID=
# E2E_TEST_USER_PASSWORD=Test1234!

# Alias accepted by scripts/test-flow.mjs:
# SUPABASE_ACCESS_TOKEN=

# Trip UUID for scripts/test-api.sh when not passed as the first CLI arg.
TEST_TRIP_ID=

# Service role (server-only). Needed by create-test-user, cron reminders,
# Stripe webhook Pro updates, and resolving E2E_TEST_USER_ID for /api/test/login.
# NEVER expose to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# App origin for HTTP steps. Default: http://localhost:3000
# scripts/test-api.sh also accepts BASE_URL (falls back to TEST_BASE_URL).
TEST_BASE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# --- Playwright e2e (local only — never enable in production) ---
# npm run test:e2e starts Next on 127.0.0.1:3333 with ENABLE_TEST_LOGIN=true.
# Auth setup prefers TEST_USER_JWT cookies; falls back to GET /api/test/login.
# POST /api/test/seed-packing seeds packing items if templates somehow fail.
ENABLE_TEST_LOGIN=false
# PLAYWRIGHT_PORT=3333
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3333
